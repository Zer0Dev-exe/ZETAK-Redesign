---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { tour, albums, videos, socials, shop } from '../data/content';

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('eu-ES', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
const next = tour.find((t) => new Date(t.date) > new Date() && t.status !== 'soldout') ?? tour[0];
const marquee = ['ZETAK', 'Zuzenean', 'Bira 2027', 'Euskal rocka', 'AAZTIYEN'];
const slides = ['bg5', 'bg7', 'bg8', 'bg6'];
const gallery = ['bg7', 'bg6', 'bg5', 'bg8', 'bg7', 'bg6'];
---
<Layout>
  <div class="grain"></div>
  <div class="progress" id="progress"></div>
  <div class="cursor" id="cursor"></div>

  <div class="loader" id="loader"><img src="/img/logo-black.png" alt="ZETAK" /></div>

  <header class="nav mono">
    <a class="logo" href="#top" aria-label="ZETAK"><img src="/img/logo-white.png" alt="ZETAK" /></a>
    <ul>
      <li><a href="#bira">Bira</a></li>
      <li><a href="#musika">Musika</a></li>
      <li><a href="#bideoak">Bideoak</a></li>
      <li><a href="#jarraitu">Jarraitu</a></li>
    </ul>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="slides" id="slides">
        {slides.map((s, i) => <div class:list={['slide', i === 0 && 'active']} style={`background-image:url(/img/${s}.jpg)`}></div>)}
      </div>
      <span class="scroll-hint mono">Scroll ↓</span>
      <img class="hero-logo" src="/img/logo-white.png" alt="ZETAK" />
      <div class="hero-foot">
        <p class="reveal">Euskal rocka. Zuzenean, sutan. Bira berria 2027.</p>
        <div class="cta reveal" style="--d:.15s">
          <a class="btn solid" href="#bira" data-hover>Tickets</a>
          <a class="btn" href="https://open.spotify.com/search/zetak" target="_blank" rel="noopener" data-hover>Entzun orain ↗</a>
        </div>
      </div>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <div style="display:flex">
            {marquee.map((m, i) => <span>{i % 2 ? <em>{m}</em> : m}<b>✦</b></span>)}
          </div>
        ))}
      </div>
    </div>

    <!-- NEXT SHOW -->
    <section id="next">
      <div class="next reveal">
        <div class="poster" data-tilt><img src="/img/fetxagabe.jpg" alt="ZETAK · Buesa Arena · Gasteiz · 2027ko urtarrila" loading="lazy" /></div>
        <div class="next-info">
          <div>
            <span class="mono muted">Hurrengo kontzertua</span>
            <h3>{next.venue}<br /><span class="muted">{next.city} · {fmt(next.date)}</span></h3>
          </div>
          <div class="count" id="count" data-date={next.date}>
            <div><b data-u="d">00</b><span class="mono">Egun</span></div>
            <div><b data-u="h">00</b><span class="mono">Ordu</span></div>
            <div><b data-u="m">00</b><span class="mono">Minutu</span></div>
            <div><b data-u="s">00</b><span class="mono">Segundu</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- TOUR -->
    <section id="bira">
      <div class="sec-head reveal"><h2>Bira</h2><span class="mono">2026 — 2027</span></div>
      <ul class="tour">
        {tour.map((t, i) => (
          <li class:list={[t.status !== 'soldout' && 'on']}>
            <a class="reveal" style={`--d:${i * 0.06}s`} href={t.status === 'tickets' ? t.url : undefined} data-hover>
              <span class="d mono">{fmt(t.date)}</span>
              <span class="v">{t.venue}</span>
              <span class="c muted">{t.city}</span>
              <span class={`tag mono ${t.status !== 'tickets' ? 'off' : ''}`}>
                {t.status === 'tickets' ? 'Tickets ↗' : t.status === 'soldout' ? 'Agortuta' : 'Laster'}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- GALLERY -->
    <section class="gallery" id="argazkiak">
      <div class="sec-head reveal"><h2>Argazkiak</h2><span class="mono">Zuzenean eta kanpoan</span></div>
      <div class="g-row" id="grow">
        {gallery.map((g) => <figure><img src={`/img/${g}.jpg`} alt="ZETAK" loading="lazy" /></figure>)}
      </div>
    </section>

    <!-- MUSIC -->
    <section id="musika">
      <div class="sec-head reveal"><h2>Musika</h2><span class="mono">Diskografia</span></div>
      <div class="albums">
        {albums.map((a, i) => (
          <a class="album reveal" style={`--d:${i * 0.1}s`} href="https://open.spotify.com/search/zetak" target="_blank" rel="noopener" data-hover>
            <div class="cover"><img src={a.img} alt={a.title} loading="lazy" /></div>
            <h3>{a.title}</h3>
            <p class="mono">{a.year} · {a.tracks} abesti</p>
          </a>
        ))}
      </div>
    </section>

    <!-- VIDEOS -->
    <section id="bideoak">
      <div class="sec-head reveal"><h2>Bideoak</h2><span class="mono">Bideoklipak</span></div>
      <ul class="videos">
        {videos.map((v, i) => (
          <li class="reveal" style={`--d:${i * 0.06}s`}>
            <a href={v.url} target="_blank" rel="noopener" data-hover>
              <span class="t">{v.title}</span>
              <span class="mono muted">{v.year}</span>
              <span class="arr">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- FOLLOW -->
    <section id="jarraitu" class="follow">
      <h2 class="reveal">Jarraitu</h2>
      <div class="socials reveal">
        {socials.map((s) => <a class="mono" href={s.url} target="_blank" rel="noopener" data-hover>{s.name}</a>)}
        <a class="mono" href={shop} target="_blank" rel="noopener" data-hover style="border-color:var(--accent);color:var(--accent)">Denda ↗</a>
      </div>
    </section>

    <div class="big-word" aria-hidden="true"><img src="/img/logo-white.png" alt="" /></div>
  </main>

  <footer class="mono"><span>ZETAK © 2026</span><a href="#top" data-hover>Gora ↑</a></footer>
</Layout>

<script>
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // loader
  document.body.classList.add('loading');
  const done = () => {
    $('#loader')?.classList.add('done');
    document.body.classList.remove('loading');
    document.body.classList.add('ready');
  };
  setTimeout(done, reduce ? 0 : 1500);

  // scroll reveal
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // progress bar
  const bar = $<HTMLElement>('#progress')!;
  const onScroll = () => {
    const h = document.documentElement;
    bar.style.transform = `scaleX(${h.scrollTop / (h.scrollHeight - h.clientHeight || 1)})`;
  };
  addEventListener('scroll', onScroll, { passive: true });

  // hero slideshow
  const slides = document.querySelectorAll('.slide');
  let si = 0;
  if (!reduce) setInterval(() => {
    slides[si].classList.remove('active');
    si = (si + 1) % slides.length;
    slides[si].classList.add('active');
  }, 6000);

  // gallery parallax
  const grow = $<HTMLElement>('#grow')!;
  const gp = () => {
    const r = grow.parentElement!.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
    const max = Math.max(0, grow.scrollWidth - innerWidth);
    grow.style.transform = `translateX(${-p * max}px)`;
  };
  if (!reduce) { addEventListener('scroll', gp, { passive: true }); gp(); }

  // cursor + orb
  const cur = $<HTMLElement>('#cursor')!;
  
  let tx = innerWidth / 2, ty = innerHeight / 2, cx = tx, cy = ty, ox = tx, oy = ty;
  addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; });
  const loop = () => {
    cx += (tx - cx) * 0.25; cy += (ty - cy) * 0.25;
    ox += (tx - ox) * 0.05; oy += (ty - oy) * 0.05;
    cur.style.transform = `translate(${cx}px,${cy}px)`;
    requestAnimationFrame(loop);
  };
  if (!reduce) loop();
  document.querySelectorAll('[data-hover]').forEach((el) => {
    el.addEventListener('pointerenter', () => cur.classList.add('big'));
    el.addEventListener('pointerleave', () => cur.classList.remove('big'));
  });

  // 3D tilt on covers
  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
      el.style.transform = `rotateY(${x * 18}deg) rotateX(${-y * 18}deg) scale(1.03)`;
    });
    el.addEventListener('pointerleave', () => (el.style.transform = ''));
  });

  // countdown
  const cd = $<HTMLElement>('#count')!;
  const target = new Date(cd.dataset.date!).getTime();
  const pad = (n: number) => String(n).padStart(2, '0');
  const tick = () => {
    let s = Math.max(0, Math.floor((target - Date.now()) / 1000));
    const v = { d: Math.floor(s / 86400), h: Math.floor((s % 86400) / 3600), m: Math.floor((s % 3600) / 60), s: s % 60 };
    (Object.keys(v) as (keyof typeof v)[]).forEach((k) => {
      const el = cd.querySelector(`[data-u="${k}"]`);
      if (el) el.textContent = pad(v[k]);
    });
  };
  tick(); setInterval(tick, 1000);
</script>
